+// fp4-unlock (batch-invariance regression test, pattern from ggml-org/llama.cpp#28488 MMVQ_BATCH / FA_BATCH):
+// batch invariance = column 0 of a MUL_MAT with ne11 = n (n = 2..n_max) must be bitwise equal to the ne11 = 1 result.
+// Compares backend1 against itself (not against CPU); the CPU result is used as a harness sanity check only.
+// Fails on stock CUDA for n >= 5 (MMVQ 4-to-2 warp switch) and n >= 9 (MMQ); passes with FP4_UNLOCK_INVARIANT=1
+// (invariant mode pins) or with the small-M kernel (FP4_UNLOCK_KERNEL=1) for NVFP4/MXFP4 n <= 8.
+static bool fp4_unlock_batch_filter_matches(const std::string & op_name, const char * op_names_filter) {
+    if (op_names_filter == nullptr) {
+        return true;
+    }
+    for (const auto & entry : op_filter_entries(op_names_filter)) {
+        if (entry.find_first_of('(') == std::string_view::npos && op_filter_entry_matches(entry, op_name)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void fp4_unlock_fill_fixed(ggml_tensor * t, uint32_t seed) {
+    const size_t nels = ggml_nelements(t);
+    std::vector<float> data(nels);
+    std::mt19937 gen(seed);
+    std::uniform_real_distribution<float> dis(-1.0f, 1.0f);
+    for (size_t i = 0; i < nels; ++i) {
+        data[i] = dis(gen);
+    }
+    if (t->type == GGML_TYPE_F32) {
+        ggml_backend_tensor_set(t, data.data(), 0, nels*sizeof(float));
+    } else if (t->type == GGML_TYPE_F16) {
+        std::vector<ggml_fp16_t> d16(nels);
+        for (size_t i = 0; i < nels; ++i) {
+            d16[i] = ggml_fp32_to_fp16(data[i]);
+        }
+        ggml_backend_tensor_set(t, d16.data(), 0, nels*sizeof(ggml_fp16_t));
+    } else {
+        GGML_ASSERT(ggml_is_quantized(t->type) || t->type == GGML_TYPE_BF16);
+        std::vector<uint8_t> dataq(ggml_row_size(t->type, nels));
+        std::vector<float> im(t->ne[0], 1.0f);
+        const float * im_ptr = ggml_quantize_requires_imatrix(t->type) ? im.data() : nullptr;
+        ggml_quantize_chunk(t->type, data.data(), dataq.data(), 0, nels/t->ne[0], t->ne[0], im_ptr);
+        ggml_backend_tensor_set(t, dataq.data(), 0, dataq.size());
+    }
+}
+
+struct test_mul_mat_batch : public test_case {
+    const ggml_type type_a;
+    const int64_t m;      // rows of a (= ne01)
+    const int64_t k;      // ne00
+    const int64_t n_max;  // compare ne11 = 2..n_max against ne11 = 1
+
+    std::string vars() override { return VARS_TO_STR4(type_a, m, k, n_max); }
+    ggml_tensor * build_graph(ggml_context * ctx) override { GGML_UNUSED(ctx); return nullptr; }
+
+    bool run_one(ggml_backend_t backend, int64_t n, std::vector<float> & col0) {
+        ggml_init_params p = { ggml_tensor_overhead()*8 + ggml_graph_overhead(), nullptr, true };
+        ggml_context * ctx = ggml_init(p);
+        ggml_tensor * a = ggml_new_tensor_2d(ctx, type_a, k, m);
+        ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+        ggml_set_name(a, "a");
+        ggml_set_name(b, "b");
+        ggml_tensor * o = ggml_mul_mat(ctx, a, b);
+        ggml_set_name(o, "out");
+        ggml_cgraph * gf = ggml_new_graph(ctx);
+        ggml_build_forward_expand(gf, o);
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+        if (!buf) { ggml_free(ctx); return false; }
+        fp4_unlock_fill_fixed(a, 123);
+        fp4_unlock_fill_fixed(b, 42);   // column 0 is the same for every n (the generator walks column 0 first)
+        const bool ok = ggml_backend_graph_compute(backend, gf) == GGML_STATUS_SUCCESS;
+        if (ok) {
+            col0.resize(m);
+            ggml_backend_tensor_get(o, col0.data(), 0, m*sizeof(float));   // column 0 = first m floats
+        }
+        ggml_backend_buffer_free(buf);
+        ggml_free(ctx);
+        return ok;
+    }
+
+    test_status_t eval(ggml_backend_t backend1, ggml_backend_t backend2, const char * op_names_filter, printer * output_printer) override {
+        GGML_UNUSED(backend2);
+        const std::string op_name = "MUL_MAT_BATCH";
+        current_op_name = op_name;
+        if (!fp4_unlock_batch_filter_matches(op_name, op_names_filter)) {
+            return test_status_t::SKIPPED;
+        }
+        const std::string backend_name = ggml_backend_name(backend1);
+        {
+            ggml_init_params p = { ggml_tensor_overhead()*4 + ggml_graph_overhead(), nullptr, true };
+            ggml_context_ptr c(ggml_init(p));
+            ggml_tensor * a = ggml_new_tensor_2d(c.get(), type_a, k, m);
+            ggml_tensor * b = ggml_new_tensor_2d(c.get(), GGML_TYPE_F32, k, n_max);
+            ggml_tensor * o = ggml_mul_mat(c.get(), a, b);
+            if (!ggml_backend_supports_op(backend1, o)) {
+                test_operation_info info(op_name, vars(), backend_name, test_status_t::NOT_SUPPORTED, "not supported");
+                if (output_printer) output_printer->print_operation(info);
+                return test_status_t::NOT_SUPPORTED;
+            }
+        }
+        // backend1 against itself: the question is whether this backend's ne11 = n result equals its own ne11 = 1 result.
+        // (No CPU reference: the CPU backend is itself not invariant for k-quants at n = 8.)
+        std::vector<float> c1, cn;
+        bool ok = run_one(backend1, 1, c1);
+        std::string detail = ok ? "" : "alloc/compute failed";
+        for (int64_t n = 2; ok && n <= n_max; ++n) {
+            if (!run_one(backend1, n, cn)) { ok = false; detail = "alloc/compute failed"; break; }
+            int diff = 0; double max_abs = 0;
+            for (int64_t i = 0; i < m; ++i) {
+                const double d = fabs(double(c1[i]) - double(cn[i]));
+                if (d != 0) { diff++; max_abs = std::max(max_abs, d); }
+            }
+            if (diff != 0) {
+                char buf[256];
+                snprintf(buf, sizeof(buf), "batch invariance broken at n=%lld: %d/%lld values differ, max %.9g", (long long) n, diff, (long long) m, max_abs);
+                detail = buf; ok = false; break;
+            }
+        }
+        const test_status_t status = ok ? test_status_t::OK : test_status_t::FAIL;
+        test_operation_info info(op_name, vars(), backend_name, status, "");
+        if (!ok) { info.set_error("compare", detail); info.set_compare_failure(); }
+        if (output_printer) output_printer->print_operation(info);
+        return status;
+    }
+
+    test_mul_mat_batch(ggml_type type_a = GGML_TYPE_Q8_0, int64_t m = 256, int64_t k = 1024, int64_t n_max = 8)
+        : type_a(type_a), m(m), k(k), n_max(n_max) {}
+};
