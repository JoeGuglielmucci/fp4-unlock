+// fp4-unlock Phase 3: dedicated small-M (ncols_dst 1..8) GEMM for NVFP4 weights on Blackwell tensor cores.
+//
+// One kernel instantiation serves every ncols_dst in 1..8; the K loop, the split-K combine and the term combine
+// depend only on the weight shape, and each output column is computed by its own MMA lanes. The arithmetic for a
+// given (row, column) therefore does not depend on how many columns are in the batch: the result for a token is
+// bitwise identical whether it is verified alone (M=1) or together with up to 7 draft tokens (M<=8). That is the
+// batch-invariance property the fp4-unlock "lossless" claim rests on.
+//
+// Two kernels (FP4_UNLOCK_KERNEL selects, see ggml_cuda_fp4_smallm_mode):
+//   v4 (default): block-scaled FP4 MMA (mma.m16n8k64 kind::mxf4nvf4) on the raw NVFP4 weight words; activations are
+//       quantized to NVFP4 by a residual expansion of FP4_UNLOCK_T terms (default 2, KL at the Q8_0-activation floor;
+//       3 = extra margin, 1 = plain W4A4), each term a
+//       separate fp32 accumulator combined at the end. Takes the f32 activations and does its own quantization.
+//   v3 (fallback / FP4_UNLOCK_KERNEL=2): int8 mma.m16n8k16 on the block_q8_1 activations that
+//       ggml_cuda_mul_mat_vec_q produces (W4A8), weights expanded nibble -> int8; scales applied in fp32 per k16.
+#pragma once
+
+#include "common.cuh"
+
+// Runtime switch FP4_UNLOCK_KERNEL: 0 = off (MMVQ), 1 = v4 FP4 MMA (v3 where unsupported), 2 = v3 int8 only,
+// 3 = v5 (v4 with the activation quantization inside the GEMM block; slower, kept for A/B).
+// Default: 1 when compiled with -DGGML_CUDA_FP4_SMALLM, 0 otherwise.
+int  ggml_cuda_fp4_smallm_mode();
+bool ggml_cuda_fp4_smallm_enabled();
+int  ggml_cuda_fp4_smallm_min_m();   // ncols_dst threshold (default 5; 1 under FP4_UNLOCK_INVARIANT); env FP4_UNLOCK_MIN_M
+// Residual activation terms of the v4 path (FP4_UNLOCK_T, 1..4, default 2).
+int  ggml_cuda_fp4_smallm_terms();
+
+// v3. src0 NVFP4 [ncols_x, nrows_x], src1 already quantized to block_q8_1 [ncols_x (padded), ncols_dst], dst f32 [nrows_x, ncols_dst].
+// stride_row_x in block_nvfp4 units, stride_col_y in block_q8_1 units, stride_col_dst in floats.
+// Precondition: ncols_dst <= 8, ncols_x % 64 == 0, single channel / sample.
+void ggml_cuda_fp4_smallm_mul_mat(
+        const void * vx, const void * vy, const ggml_cuda_mm_fusion_args_device & fusion, bool has_fusion, float * dst,
+        int ncols_x, int nrows_x, int ncols_dst, int stride_row_x, int stride_col_y, int stride_col_dst, cudaStream_t stream);
+
+// v4 eligibility: 16-byte aligned weight rows in whole 256-k chunks (ncols_x % 256 == 0, ncols_x <= 32768), 16-byte
+// aligned f32 activation columns (stride_col_y in floats), CUDA >= 12.8.
+bool ggml_cuda_fp4_smallm_v4_supported(const void * vx, const void * gate, const float * y, int ncols_x, int stride_row_x, int stride_col_y);
+
+// v4. src1 is the f32 activation matrix [ncols_x, ncols_dst] (column stride stride_col_y floats); the activation
+// quantization buffer comes from the pool. Same preconditions as above plus ggml_cuda_fp4_smallm_v4_supported.
+void ggml_cuda_fp4_smallm_mul_mat_f32(
+        ggml_cuda_pool & pool, const void * vx, const float * y, const ggml_cuda_mm_fusion_args_device & fusion, bool has_fusion,
+        float * dst, int ncols_x, int nrows_x, int ncols_dst, int stride_row_x, int stride_col_y, int stride_col_dst,
+        int stream_no, cudaStream_t stream);
