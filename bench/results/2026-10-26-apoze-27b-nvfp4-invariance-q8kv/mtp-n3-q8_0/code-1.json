st_.begin(), list_, it->second);\n   } else {\n      if (capacity_ == 0) return; // no storage\n      if (list_.size() == capacity_) {\n         auto old = list_.back();\n         map_.erase(old.first);\n         list_.pop_back();\n      }\n      list_.emplace_front(key, value);\n      map_.emplace(key, list_.begin());\n   }\n }\n bool erase(const Key& key) {\n   lock;\n   auto it = map_.find(key);\n   if (it == map_.end()) return false;\n   list_.erase(it->second);\n   map_.erase(it);\n   return true;\n }\n size_t size() const {\n   std::lock_guard<std::mutex> lock(mutex_);\n   return list_.size();\n }\nprivate:\n size_t capacity_;\n std::mutex mutex_;", "top2": [[[1596, -0.003991512581706047], [22916, -6.3334479331970215]], [[1144, -8.333076402777806e-05], [513, -9.670626640319824]], [[4087, -0.03302626684308052], [5707, -4.031458377838135]], [[1156, -0.004870574455708265], [310, -5.741730690002441]], [[579, -0.5955761075019836], [25, -1.110405683517456]], [[1622, -0.007513726130127907], [10505, -5.241247653961182]], [[13, -0.19836415350437164], [25, -1.7345770597457886]], [[14235, -0.023016758263111115], [26472, -4.811934471130371]], [[4072, -0.22577765583992004], [7936, -1.6742181777954102]], [[4368, -0.5429749488830566], [351, -1.303625464439392]], [[53269, -1.7762342395144515e-05], [5902, -11.436446189880371]], [[436, -0.000647217791993171], [4108, -8.015950202941895]], [[34810, -1.9073668227065355e-05], [2585, -11.032699584960938]], [[6297, -0.0027681123465299606], [351, -5.9388298988342285]], [[351, -0.48240944743156433], [303, -1.0364922285079956]], [[992, -3.57628505298635e-06], [587, -13.314918518066406]], [[16, -0.0018610379192978144], [5469, -6.98158597946167]], [[22, -0.0010296637192368507], [16, -6.936662197113037]], [[4108, -1.180178969661938e-05], [11, -12.641679763793945]], [[14934, -0.00015999165771063417], [1132, -8.792003631591797]], [[523, -0.018405945971608162], [3683, -4.018299102783203]], [[3683, -3.635949542513117e-05], [436, -10.4637756347