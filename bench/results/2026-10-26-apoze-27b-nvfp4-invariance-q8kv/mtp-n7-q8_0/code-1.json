.begin(), list_, it->second);\n   } else {\n      if (capacity_ == 0) return; // no storage\n      if (list_.size() == capacity_) {\n         auto old = list_.back();\n         map_.erase(old.first);\n         list_.pop_back();\n      }\n      list_.emplace_front(key, value);\n      map_[key] = list_.begin();\n   }\n }\n bool erase(const Key& key) {\n   lock;\n   auto it = map_.find(key);\n   if (it == map_.end()) return false;\n   list_.erase(it->second);\n   map_.erase(it);\n   return true;\n }\n size_t size() const {\n   std::lock_guard<std::mutex> lock(mutex_);\n   return list_.size();\n }\nprivate:\n size_t capacity_;\n std::mutex mutex_;", "top2": [[[1596, -0.003991512581706047], [22916, -6.3334479331970215]], [[1144, -0.00011051311594201252], [513, -9.339553833007812]], [[4087, -0.03328769654035568], [5707, -4.008932590484619]], [[1156, -0.0034786697942763567], [310, -6.208846569061279]], [[579, -0.5673273801803589], [25, -1.1497726440429688]], [[1622, -0.006485466845333576], [10505, -5.411125659942627]], [[13, -0.19842122495174408], [25, -1.7398335933685303]], [[14235, -0.022540217265486717], [26472, -4.806513786315918]], [[4072, -0.20869490504264832], [7936, -1.7493882179260254]], [[4368, -0.6001349091529846], [351, -1.177083134651184]], [[53269, -1.764313128660433e-05], [5902, -11.469719886779785]], [[436, -0.0007001227932050824], [4108, -7.80787467956543]], [[34810, -2.0384995877975598e-05], [2585, -10.969098091125488]], [[6297, -0.002868112176656723], [351, -5.900973796844482]], [[351, -0.4741339385509491], [303, -1.0476621389389038]], [[992, -3.337865791763761e-06], [587, -13.337563514709473]], [[16, -0.002187377540394664], [5469, -6.850947856903076]], [[22, -0.001124119502492249], [16, -6.858729362487793]], [[4108, -1.0132840543519706e-05], [11, -12.849671363830566]], [[14934, -0.00015689173596911132], [1132, -8.813843727111816]], [[523, -0.020634062588214874], [3683, -3.9049417972564697]], [[3683, -3.886298509314656e-05], [436, -10.405831336975098]], 