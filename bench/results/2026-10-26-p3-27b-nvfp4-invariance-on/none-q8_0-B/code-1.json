.begin(), list_, it->second);\n   } else {\n      if (capacity_ == 0) return; // no storage\n      if (list_.size() == capacity_) {\n         auto old = list_.back();\n         map_.erase(old.first);\n         list_.pop_back();\n      }\n      list_.emplace_front(key, value);\n      map_[key] = list_.begin();\n   }\n }\n bool erase(const Key& key) {\n   lock;\n   auto it = map_.find(key);\n   if (it == map_.end()) return false;\n   list_.erase(it->second);\n   map_.erase(it);\n   return true;\n }\n size_t size() const {\n   std::lock_guard<std::mutex> lock(mutex_);\n   return list_.size();\n }\nprivate:\n size_t capacity_;\n std::mutex mutex_;", "top2": [[[1596, -0.004665452521294355], [22916, -6.10151481628418]], [[1144, -5.722209607483819e-05], [513, -10.235919952392578]], [[4087, -0.029554948210716248], [5707, -4.22777795791626]], [[1156, -0.003876201808452606], [310, -6.059835910797119]], [[579, -0.6061785221099854], [25, -1.1003763675689697]], [[1622, -0.006699842866510153], [10505, -5.357230186462402]], [[13, -0.20181109011173248], [25, -1.725563406944275]], [[14235, -0.02137472666800022], [1165, -4.852408409118652]], [[4072, -0.23634548485279083], [7936, -1.627962350845337]], [[4368, -0.5663487911224365], [351, -1.2565456628799438]], [[53269, -1.7285496141994372e-05], [5902, -11.476217269897461]], [[436, -0.00061089574592188], [4108, -8.115281105041504]], [[34810, -1.8477610865375027e-05], [2585, -11.052708625793457]], [[6297, -0.0027734916657209396], [351, -5.935613632202148]], [[351, -0.4554084241390228], [303, -1.0808433294296265]], [[992, -3.57628505298635e-06], [587, -13.312877655029297]], [[16, -0.0018893436063081026], [5469, -7.070063591003418]], [[22, -0.0010066925315186381], [16, -6.962253093719482]], [[4108, -1.2159421203250531e-05], [11, -12.549521446228027]], [[14934, -0.0001554609916638583], [1132, -8.820528984069824]], [[523, -0.018263768404722214], [3683, -4.025908470153809]], [[3683, -3.3736796467565e-05], [436, -10.551871299743652]], [[436, -