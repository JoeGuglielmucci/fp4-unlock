d<std::mutex> lock(mutex_);\n   auto it = map_.find(key);\n   if (it == map_.end()) return std::nullopt;\n   list_.splice(list_.begin(), list_, it->second);\n   return it->second->value;\n }\n void put(const Key& key, const Value& value) {\n   lock;\n   auto it = map_.find(key);\n   if (it != map_.end()) {\n      it->second->value = value;\n      list_.splice(list_.begin(), list_, it->second);\n   } else {\n      if (capacity_ == 0) return; // no storage\n      if (list_.size() == capacity_) {\n         auto old = list_.back();\n         map_.erase(old->key);\n         list_.pop_back();\n      }\n      list_.emplace_front(key, value);\n      map_.emplace(key, list_.begin());\n   }\n }\n bool erase(const Key& key) {\n  ", "top2": [[[1596, -0.0044534881599247456], [22916, -6.5470733642578125]], [[1144, -0.00017710108659230173], [513, -8.677221298217773]], [[4087, -0.02249833568930626], [5707, -4.445826530456543]], [[1156, -0.005033443681895733], [310, -5.770112991333008]], [[579, -0.7052879333496094], [25, -1.0076522827148438]], [[1622, -0.010724145919084549], [10505, -4.875372886657715]], [[13, -0.21723535656929016], [25, -1.6518781185150146]], [[14235, -0.025880487635731697], [1165, -4.641793727874756]], [[4072, -0.200509712100029], [7936, -1.7916429042816162]], [[4368, -0.622230589389801], [351, -1.1882284879684448]], [[53269, -2.1815538275404833e-05], [5902, -11.17722225189209]], [[436, -0.0007742063025943935], [4108, -7.811580657958984]], [[34810, -2.6464813345228322e-05], [2585, -10.648292541503906]], [[6297, -0.005139362066984177], [351, -5.307450294494629]], [[351, -0.3741267919540405], [303, -1.2746890783309937]], [[992, -3.337865791763761e-06], [587, -13.298794746398926]], [[16, -0.001185404253192246], [5469, -8.06617546081543]], [[22, -0.0006743558333255351], [16, -7.371912956237793]], [[4108, -1.2517053619376384e-05], [11, -12.689373970031738]], [[14934, -0.00016607233555987477], [1132, -8.757987976074219]], [[523, -0.022859837859869003], [3683, -3.8055498