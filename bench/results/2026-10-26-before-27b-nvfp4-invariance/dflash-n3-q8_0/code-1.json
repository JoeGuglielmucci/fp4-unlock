st_.begin(), list_, it->second);\n   } else {\n      if (capacity_ == 0) return; // no storage\n      if (list_.size() == capacity_) {\n         auto old = list_.back();\n         map_.erase(old.first);\n         list_.pop_back();\n      }\n      list_.emplace_front(key, value);\n      map_.emplace(key, list_.begin());\n   }\n }\n bool erase(const Key& key) {\n   lock;\n   auto it = map_.find(key);\n   if (it == map_.end()) return false;\n   list_.erase(it->second);\n   map_.erase(it);\n   return true;\n }\n size_t size() const {\n   std::lock_guard<std::mutex> lock(mutex_);\n   return list_.size();\n }\nprivate:\n size_t capacity_;\n std::mutex mutex_;", "top2": [[[1596, -0.004408645909279585], [22916, -6.225970268249512]], [[1144, -0.0001748357026372105], [513, -8.776267051696777]], [[4087, -0.033362384885549545], [5707, -4.1443376541137695]], [[1156, -0.00396087346598506], [310, -5.999072551727295]], [[579, -0.5887857675552368], [25, -1.1077677011489868]], [[1622, -0.006804377306252718], [10505, -5.3345441818237305]], [[13, -0.20087987184524536], [25, -1.7255839109420776]], [[14235, -0.021803075447678566], [1165, -4.879556655883789]], [[4072, -0.2671808898448944], [7936, -1.5209687948226929]], [[4368, -0.6004102230072021], [351, -1.19840407371521]], [[53269, -1.8358399756834842e-05], [5902, -11.403672218322754]], [[436, -0.0006275357445701957], [4108, -8.035751342773438]], [[34810, -1.8239186829305254e-05], [2585, -11.06352710723877]], [[6297, -0.0027417540550231934], [351, -5.950526237487793]], [[351, -0.47171053290367126], [303, -1.0584415197372437]], [[992, -3.57628505298635e-06], [587, -13.339740753173828]], [[16, -0.0019393282709643245], [5469, -6.867063045501709]], [[22, -0.0010700584389269352], [16, -6.901876449584961]], [[4108, -1.2159421203250531e-05], [11, -12.57801342010498]], [[14934, -0.00015641482605133206], [1132, -8.817333221435547]], [[523, -0.018307050690054893], [3683, -4.023756504058838]], [[3683, -3.349837061250582e-05], [436, -10.55812740325