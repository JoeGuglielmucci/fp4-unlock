.begin(), list_, it->second);\n   } else {\n      if (capacity_ == 0) return; // no storage\n      if (list_.size() == capacity_) {\n         auto old = list_.back();\n         map_.erase(old.first);\n         list_.pop_back();\n      }\n      list_.emplace_front(key, value);\n      map_[key] = list_.begin();\n   }\n }\n bool erase(const Key& key) {\n   lock;\n   auto it = map_.find(key);\n   if (it == map_.end()) return false;\n   list_.erase(it->second);\n   map_.erase(it);\n   return true;\n }\n size_t size() const {\n   std::lock_guard<std::mutex> lock(mutex_);\n   return list_.size();\n }\nprivate:\n size_t capacity_;\n std::mutex mutex_;", "top2": [[[1596, -0.004408645909279585], [22916, -6.225970268249512]], [[1144, -8.190013613784686e-05], [513, -9.69651985168457]], [[4087, -0.03265054151415825], [310, -4.181936740875244]], [[1156, -0.0041698007844388485], [310, -5.951208591461182]], [[579, -0.5490218997001648], [25, -1.1698544025421143]], [[1622, -0.007043792400509119], [10505, -5.331920623779297]], [[13, -0.21154384315013885], [25, -1.6783827543258667]], [[14235, -0.021712249144911766], [26472, -4.839354515075684]], [[4072, -0.22661848366260529], [7936, -1.6683070659637451]], [[4368, -0.5622559189796448], [351, -1.2596054077148438]], [[53269, -1.895445711852517e-05], [5902, -11.364141464233398]], [[436, -0.0006394642405211926], [4108, -8.049235343933105]], [[34810, -1.978893851628527e-05], [2585, -10.99633502960205]], [[6297, -0.002913303906098008], [351, -5.886911869049072]], [[351, -0.4522382616996765], [303, -1.0874520540237427]], [[992, -3.57628505298635e-06], [587, -13.364950180053711]], [[16, -0.0019207553705200553], [5469, -6.911100387573242]], [[22, -0.0012261633528396487], [16, -6.764033794403076]], [[4108, -1.0728893357736524e-05], [11, -12.779757499694824]], [[14934, -0.000163806980708614], [1132, -8.767526626586914]], [[523, -0.018392346799373627], [3683, -4.019445419311523]], [[3683, -3.349837061250582e-05], [436, -10.565054893493652]], [[436,