.begin(), list_, it->second);\n   } else {\n      if (capacity_ == 0) return; // no storage\n      if (list_.size() == capacity_) {\n         auto old = list_.back();\n         map_.erase(old.first);\n         list_.pop_back();\n      }\n      list_.emplace_front(key, value);\n      map_[key] = list_.begin();\n   }\n }\n bool erase(const Key& key) {\n   lock;\n   auto it = map_.find(key);\n   if (it == map_.end()) return false;\n   list_.erase(it->second);\n   map_.erase(it);\n   return true;\n }\n size_t size() const {\n   std::lock_guard<std::mutex> lock(mutex_);\n   return list_.size();\n }\nprivate:\n size_t capacity_;\n std::mutex mutex_;", "top2": [[[1596, -0.004408645909279585], [22916, -6.225970268249512]], [[1144, -0.00011444746633060277], [513, -9.26339340209961]], [[4087, -0.027204781770706177], [5707, -4.294527530670166]], [[1156, -0.005482775624841452], [310, -5.633543968200684]], [[579, -0.6103019118309021], [25, -1.1230238676071167]], [[1622, -0.007123569957911968], [10505, -5.359858989715576]], [[13, -0.17910131812095642], [25, -1.8373483419418335]], [[14235, -0.022274330258369446], [26472, -4.83537483215332]], [[4072, -0.24042437970638275], [7936, -1.6166298389434814]], [[4368, -0.5526608228683472], [351, -1.2888535261154175]], [[53269, -1.8596821973915212e-05], [5902, -11.39297103881836]], [[436, -0.0007042980287224054], [4108, -7.8837666511535645]], [[34810, -1.8000764612224884e-05], [2585, -11.11398983001709]], [[6297, -0.003320299321785569], [351, -5.751565456390381]], [[351, -0.4660475254058838], [303, -1.0739481449127197]], [[992, -3.4570753086882178e-06], [587, -13.32486343383789]], [[16, -0.0021398894023150206], [5469, -6.927349090576172]], [[22, -0.0007873295689933002], [16, -7.2086005210876465]], [[4108, -1.1444157280493528e-05], [11, -12.659467697143555]], [[14934, -0.00013996149937156588], [1132, -8.931841850280762]], [[523, -0.020715419203042984], [3683, -3.9015653133392334]], [[3683, -3.4690503525780514e-05], [436, -10.526506423950195]