st_.begin(), list_, it->second);\n   } else {\n      if (capacity_ == 0) return; // no storage\n      if (list_.size() == capacity_) {\n         auto back = list_.back();\n         map_.erase(back.first);\n         list_.pop_back();\n      }\n      list_.emplace_front(key, value);\n      map_.emplace(key, list_.begin());\n   }\n }\n bool erase(const Key& key) {\n   lock;\n   auto it = map_.find(key);\n   if (it == map_.end()) return false;\n   list_.erase(it->second);\n   map_.erase(it);\n   return true;\n }\n size_t size() const {\n   std::lock_guard<std::mutex> lock(mutex_);\n   return list_.size();\n }\nprivate:\n size_t capacity_;\n std::mutex mutex_;", "top2": [[[1596, -0.005178964696824551], [22916, -6.0443291664123535]], [[1144, -9.036472329171374e-05], [513, -9.526957511901855]], [[4087, -0.03724859282374382], [5707, -3.950458526611328]], [[1156, -0.0042580291628837585], [310, -5.932431221008301]], [[579, -0.5793344378471375], [25, -1.131878137588501]], [[1622, -0.0066607799381017685], [10505, -5.36870813369751]], [[13, -0.1951397955417633], [25, -1.7524651288986206]], [[14235, -0.021213436499238014], [1165, -4.881435394287109]], [[4072, -0.2672610282897949], [7936, -1.5220330953598022]], [[4368, -0.5838295221328735], [351, -1.2300125360488892]], [[53269, -1.811997572076507e-05], [5902, -11.41907024383545]], [[436, -0.0006369592156261206], [4108, -8.08089828491211]], [[34810, -1.7762342395144515e-05], [2585, -11.09616756439209]], [[6297, -0.0029307592194527388], [351, -5.880801200866699]], [[351, -0.44365382194519043], [303, -1.1045407056808472]], [[992, -3.57628505298635e-06], [587, -13.361549377441406]], [[16, -0.0018938820576295257], [5469, -6.965349197387695]], [[22, -0.0011274612043052912], [16, -6.845848083496094]], [[4108, -1.180178969661938e-05], [11, -12.620059967041016]], [[14934, -0.0001620185503270477], [1132, -8.77889633178711]], [[523, -0.01949716918170452], [3683, -3.9624598026275635]], [[3683, -3.576342714950442e-05], [436, -10.49868106842041