ct { Name, Email string }\nfunc parseUserID(raw string) (int, error) { id, err := strconv.Atoi(raw); if err != nil || id <=0 { return 0, ErrInvalidID } return id, nil }\nfunc getUser(db *sql.DB, id int) (User, error) { row := db.QueryRow(...); var u User; err := row.Scan(&u.Name, &u.Email); if err != nil { if errors.Is(err, sql.ErrNoRows) { return User{}, ErrUserNotFound }; return User{}, err } return u, nil }\nfunc writeJSON(w http.ResponseWriter, status int, v interface{})? But original success sets Content-Type and encodes map. Error responses do not set Content-Type. If we use generic writeJSON for all, would change headers for errors. Need keep identical. Could have writeError(w, status, message) that writes exact body no content type. And writeUserJSON(w, u) sets content type and encodes map. But JSON encoding separated into testable function? Could define encodeUser(w, u) error? But to test JSON encoding maybe use htt", "top2": [[[1596, -0.005268240813165903], [760, -6.553199768066406]], [[1144, -4.4466054532676935e-05], [513, -10.311003684997559]], [[4087, -0.044306445866823196], [310, -3.776350736618042]], [[1156, -0.001963813789188862], [303, -6.700669288635254]], [[579, -0.21422234177589417], [25, -2.602234125137329]], [[1622, -0.0009936856804415584], [10505, -8.170307159423828]], [[13, -0.34433650970458984], [25, -1.9273768663406372]], [[14235, -0.02915315330028534], [26472, -4.3680548667907715]], [[7936, -0.6078908443450928], [89109, -1.1037023067474365]], [[1534, -0.18407055735588074], [2400, -2.2268028259277344]], [[25, -0.8938852548599243], [440, -0.9554659724235535]], [[2400, -0.11841609328985214], [1985, -2.4396727085113525]], [[1985, -4.124726547161117e-05], [5805, -10.443285942077637]], [[519, -0.00011862027895404026], [21479, -9.073282241821289]], [[2922, -0.007232531905174255], [5805, -5.412891387939453]], [[5805, -0.2741910219192505], [999, -1.428695797920227]], [[999, -0.0025065934751182795], [9830, -6.153280735015869]], [[11, -0.183950826525