ct { Name, Email string }\nfunc parseUserID(raw string) (int, error) { id, err := strconv.Atoi(raw); if err != nil || id <=0 { return 0, ErrInvalidID } return id, nil }\nfunc getUser(db *sql.DB, id int) (User, error) { row := db.QueryRow(...); var u User; err := row.Scan(&u.Name, &u.Email); if err != nil { if errors.Is(err, sql.ErrNoRows) { return User{}, ErrUserNotFound }; return User{}, err } return u, nil }\nfunc writeJSON(w http.ResponseWriter, status int, v interface{})? But original success sets Content-Type and encodes map. Error responses do not set Content-Type. If we use generic writeJSON for all, would change headers for errors. Need keep identical. Could have writeError(w, status, message) that writes exact body no content type. And writeUserJSON(w, u) sets content type and encodes map. But JSON encoding separated into testable function? Could define encodeUser(w, u) error? But to test JSON encoding maybe use htt", "top2": [[[1596, -0.005268240813165903], [760, -6.553199768066406]], [[1144, -3.5167358873877674e-05], [513, -10.633069038391113]], [[4087, -0.06324947625398636], [310, -3.3892059326171875]], [[1156, -0.0026515081990510225], [303, -6.359995365142822]], [[579, -0.20282143354415894], [25, -2.6582162380218506]], [[1622, -0.0010371817043051124], [10505, -8.190414428710938]], [[13, -0.344175785779953], [303, -1.8275437355041504]], [[14235, -0.03228425234556198], [26472, -4.238575458526611]], [[7936, -0.5724073648452759], [89109, -1.1718354225158691]], [[1534, -0.18483750522136688], [2400, -2.220712900161743]], [[25, -0.902694046497345], [440, -0.9273598194122314]], [[2400, -0.11509384214878082], [1985, -2.475397825241089]], [[1985, -3.9816695789340883e-05], [5805, -10.472463607788086]], [[519, -0.000122912329970859], [21479, -9.038653373718262]], [[2922, -0.008221594616770744], [5805, -5.252179145812988]], [[5805, -0.26784104108810425], [999, -1.4491384029388428]], [[999, -0.0026708715595304966], [9830, -6.0829339027404785]], [[11, -0.1865665316581