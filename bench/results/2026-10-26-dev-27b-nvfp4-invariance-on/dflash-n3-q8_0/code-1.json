st_.begin(), list_, it->second);\n   } else {\n      if (capacity_ == 0) return; // no storage\n      if (list_.size() == capacity_) {\n         auto old = list_.back();\n         map_.erase(old.first);\n         list_.pop_back();\n      }\n      list_.emplace_front(key, value);\n      map_.emplace(key, list_.begin());\n   }\n }\n bool erase(const Key& key) {\n   lock;\n   auto it = map_.find(key);\n   if (it == map_.end()) return false;\n   list_.erase(it->second);\n   map_.erase(it);\n   return true;\n }\n size_t size() const {\n   std::lock_guard<std::mutex> lock(mutex_);\n   return list_.size();\n }\nprivate:\n size_t capacity_;\n std::mutex mutex_;", "top2": [[[1596, -0.004437742289155722], [22916, -6.157325267791748]], [[1144, -6.771316839149222e-05], [513, -9.858138084411621]], [[4087, -0.03587399050593376], [5707, -3.9067389965057373]], [[1156, -0.003640953917056322], [310, -6.080264568328857]], [[579, -0.6088072657585144], [25, -1.0780742168426514]], [[1622, -0.006706203334033489], [10505, -5.352470397949219]], [[13, -0.20037591457366943], [25, -1.7261288166046143]], [[14235, -0.0218691136687994], [1165, -4.872069835662842]], [[4072, -0.25815168023109436], [7936, -1.551822304725647]], [[4368, -0.5932115316390991], [351, -1.2226556539535522]], [[53269, -1.8477610865375027e-05], [5902, -11.398932456970215]], [[436, -0.0006682124803774059], [4108, -7.9569783210754395]], [[34810, -1.8239186829305254e-05], [2585, -11.0656156539917]], [[6297, -0.0030316724441945553], [351, -5.845017433166504]], [[351, -0.4789741337299347], [303, -1.0495460033416748]], [[992, -3.337865791763761e-06], [587, -13.434416770935059]], [[16, -0.001793800387531519], [5469, -7.046147346496582]], [[22, -0.0010937470942735672], [16, -6.876114845275879]], [[4108, -1.2278632311790716e-05], [11, -12.57548999786377]], [[14934, -0.0001518841745564714], [1132, -8.846673011779785]], [[523, -0.018789414316415787], [3683, -3.9985218048095703]], [[3683, -3.349837061250582e-05], [436, -10.5806989669799