.begin(), list_, it->second);\n   } else {\n      if (capacity_ == 0) return; // no storage\n      if (list_.size() == capacity_) {\n         auto old = list_.back();\n         map_.erase(old.first);\n         list_.pop_back();\n      }\n      list_.emplace_front(key, value);\n      map_[key] = list_.begin();\n   }\n }\n bool erase(const Key& key) {\n   lock;\n   auto it = map_.find(key);\n   if (it == map_.end()) return false;\n   list_.erase(it->second);\n   map_.erase(it);\n   return true;\n }\n size_t size() const {\n   std::lock_guard<std::mutex> lock(mutex_);\n   return list_.size();\n }\nprivate:\n size_t capacity_;\n std::mutex mutex_;", "top2": [[[1596, -0.004437742289155722], [22916, -6.157325267791748]], [[1144, -0.00011087078746641055], [513, -9.24610710144043]], [[4087, -0.03203687071800232], [5707, -4.028904914855957]], [[1156, -0.0037120848428457975], [310, -6.071091175079346]], [[579, -0.5860596895217896], [25, -1.1009083986282349]], [[1622, -0.006404360290616751], [10505, -5.429652690887451]], [[13, -0.18374137580394745], [25, -1.8063266277313232]], [[14235, -0.023282110691070557], [1165, -4.774163246154785]], [[4072, -0.2399366945028305], [7936, -1.6180933713912964]], [[4368, -0.5928747057914734], [351, -1.2059136629104614]], [[53269, -1.7166285033454187e-05], [5902, -11.468523025512695]], [[436, -0.0007603674312122166], [4108, -7.765626430511475]], [[34810, -2.1100266167195514e-05], [2585, -10.954784393310547]], [[6297, -0.0025895358994603157], [351, -6.003621578216553]], [[351, -0.49247756600379944], [303, -1.0183755159378052]], [[992, -3.4570753086882178e-06], [587, -13.428241729736328]], [[16, -0.0018551858374848962], [5469, -6.988320827484131]], [[22, -0.0010075278114527464], [16, -6.972239017486572]], [[4108, -1.0490472959645558e-05], [11, -12.7572660446167]], [[14934, -0.00016297238471452147], [1132, -8.771992683410645]], [[523, -0.02002139575779438], [3683, -3.9339046478271484]], [[3683, -2.8610638764803298e-05], [436, -10.739137649536133]]