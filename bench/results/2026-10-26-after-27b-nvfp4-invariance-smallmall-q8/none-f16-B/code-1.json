st_.begin(), list_, it->second);\n   } else {\n      if (capacity_ == 0) return; // no storage\n      if (list_.size() == capacity_) {\n         auto old = list_.back();\n         map_.erase(old.first);\n         list_.pop_back();\n      }\n      list_.emplace_front(key, value);\n      map_.emplace(key, list_.begin());\n   }\n }\n bool erase(const Key& key) {\n   lock;\n   auto it = map_.find(key);\n   if (it == map_.end()) return false;\n   list_.erase(it->second);\n   map_.erase(it);\n   return true;\n }\n size_t size() const {\n   std::lock_guard<std::mutex> lock(mutex_);\n   return list_.size();\n }\nprivate:\n size_t capacity_;\n std::mutex mutex_;", "top2": [[[1596, -0.0044534881599247456], [22916, -6.5470733642578125]], [[1144, -0.00013638472591992468], [513, -8.965367317199707]], [[4087, -0.021776637062430382], [5707, -4.465717792510986]], [[1156, -0.004637787118554115], [310, -5.910202980041504]], [[579, -0.6871609091758728], [25, -1.015038013458252]], [[1622, -0.0084513109177351], [10505, -5.139265060424805]], [[13, -0.20925171673297882], [25, -1.6868631839752197]], [[14235, -0.025239169597625732], [26472, -4.709481716156006]], [[4072, -0.24357126653194427], [7936, -1.610713005065918]], [[4368, -0.5663442015647888], [351, -1.2529667615890503]], [[53269, -2.062341991404537e-05], [5902, -11.248861312866211]], [[436, -0.0007606060244143009], [4108, -7.860480785369873]], [[34810, -2.396135460003279e-05], [2585, -10.765904426574707]], [[6297, -0.004979710094630718], [351, -5.341573238372803]], [[351, -0.36477550864219666], [303, -1.2906502485275269]], [[992, -3.57628505298635e-06], [587, -13.25666618347168]], [[16, -0.0011923265410587192], [5469, -7.797081470489502]], [[22, -0.0005790479481220245], [16, -7.530148506164551]], [[4108, -1.23978434203309e-05], [11, -12.680306434631348]], [[14934, -0.00017107996973209083], [1132, -8.725897789001465]], [[523, -0.021402006968855858], [3683, -3.8726308345794678]], [[3683, -5.5672287999186665e-05], [436, -9.976642608642