st_.begin(), list_, it->second);\n   } else {\n      if (capacity_ == 0) return; // no storage\n      if (list_.size() == capacity_) {\n         auto back = list_.back();\n         map_.erase(back.first);\n         list_.pop_back();\n      }\n      list_.emplace_front(key, value);\n      map_.emplace(key, list_.begin());\n   }\n }\n bool erase(const Key& key) {\n   lock;\n   auto it = map_.find(key);\n   if (it == map_.end()) return false;\n   list_.erase(it->second);\n   map_.erase(it);\n   return true;\n }\n size_t size() const {\n   std::lock_guard<std::mutex> lock(mutex_);\n   return list_.size();\n }\nprivate:\n size_t capacity_;\n std::mutex mutex_;", "top2": [[[1596, -0.005553857889026403], [22916, -5.875037670135498]], [[1144, -6.49711728328839e-05], [513, -9.87057113647461]], [[4087, -0.033951032906770706], [5707, -3.9283621311187744]], [[1156, -0.004678746685385704], [310, -5.816865921020508]], [[579, -0.5595163702964783], [25, -1.168879747390747]], [[1622, -0.006699842866510153], [10505, -5.374946117401123]], [[13, -0.20550300180912018], [25, -1.7096608877182007]], [[14235, -0.02219540625810623], [26472, -4.854745388031006]], [[4072, -0.27156710624694824], [7936, -1.5105903148651123]], [[4368, -0.5677332282066345], [351, -1.2512181997299194]], [[53269, -1.8596821973915212e-05], [5902, -11.40247631072998]], [[436, -0.0006626059184782207], [4108, -8.005501747131348]], [[34810, -1.811997572076507e-05], [2585, -11.075167655944824]], [[6297, -0.003104733070358634], [351, -5.823668956756592]], [[351, -0.4377667307853699], [303, -1.1165845394134521]], [[992, -3.4570753086882178e-06], [587, -13.385643005371094]], [[16, -0.0018387642921879888], [5469, -7.08929443359375]], [[22, -0.001212914939969778], [16, -6.770027160644531]], [[4108, -1.180178969661938e-05], [11, -12.674261093139648]], [[14934, -0.00016225701256189495], [1132, -8.778919219970703]], [[523, -0.019252020865678787], [3683, -3.975226640701294]], [[3683, -3.874376852763817e-05], [436, -10.404011726379